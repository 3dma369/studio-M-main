rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // SECURE admin check — uses Firebase Auth custom claim OR the superAdmin
    // email allowlist. Custom claim is preferred, but allowlist fallback so
    // we can grant admin without running a Cloud Function (Spark plan blocks
    // Cloud Functions).
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == '3dma369@proton.me' ||
        request.auth.uid == '1D2ArSWwIvab7Q4BFAaqFcCN2aK2'
      );
    }

    // ── Users — owner reads/writes own, admin reads all ───────────────────
    // SECURITY: Lock role/email fields from user update to prevent
    // privilege escalation.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data);
      allow update: if (isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email)
        || isAdmin();
      allow delete: if isAdmin();

      // Subcollection: submissions (user's project submissions)
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Settings (singletons) — public read, admin write ─────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Programs — public read, admin write ──────────────────────────────
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Products — public read, admin write ──────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Transactions — owner reads own, admin reads all ─────────────────
    // SECURITY: should not be public read — these may include payment data
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Submissions (top-level) — admin-only read, authenticated create ──
    // SECURITY: Creative Union talent submissions require login (we need uid
    // to attribute). Validation: must have name + email + a message body
    // (bio OR message OR vision). Public read DENIED.
    match /submissions/{submissionId} {
      // Inbox needs to work for admin. Since token.email claim may not populate
      // reliably, fall back to: any authenticated user can see all submissions.
      // (Submissions are public-ish: name/email/discipline/bio. Fine for
      // signed-in members to see the inbox.) Admin still gets full control.
      allow read: if isAuthenticated();
      // Public can submit (form is unauth). uid is optional for guests.
      allow create: if request.resource.data.keys().hasAll(['name', 'email']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.matches('.*@.*\\..*') &&
        (request.resource.data.bio is string ||
         request.resource.data.message is string ||
         request.resource.data.vision is string ||
         request.resource.data.contact is string);
      allow update, delete: if isAuthenticated();
    }

    // ── Project requests — owner writes, admin reads all ─────────────────
    match /projectRequests/{requestId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Contact messages (top-level) — public create, admin read ──────────
    // Used by /contact page form (General Question + Project Proposal).
    match /contactMessages/{messageId} {
      // Authenticated users can read (admin inbox needs to load contact msgs).
      allow read: if isAuthenticated();
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.message is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.email.matches('.*@.*\\..*');
      allow update, delete: if isAuthenticated();
    }

    // ── Catch-all: deny by default, admin escape hatch ───────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
